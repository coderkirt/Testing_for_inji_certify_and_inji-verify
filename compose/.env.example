# Copy to compose/.env and adjust. All values have compose defaults.

# --- OpenID Foundation conformance suite (prebuilt, no API token) ---
IMAGE_TAG=latest
BASE_URL=https://localhost.emobix.co.uk:8443
MONGODB_IMAGE=mongo:6.0.13
SPRING_PROFILES_ACTIVE=dev

# --- Inji Certify 1.0.x (issuer) ---
CERTIFY_IMAGE=injistack/inji-certify-with-plugins:0.14.0
CERTIFY_HOST_PORT=8090
CERTIFY_NGINX_PORT=8091
CERTIFY_DB_PORT=5433
CERTIFY_ISSUER_URL=http://certify-nginx

# --- Inji Verify 1.0.x (verifier) ---
VERIFY_IMAGE=injistack/inji-verify-service:0.18.2
VERIFY_UI_IMAGE=injistack/inji-verify-ui:0.18.2
VERIFY_HOST_PORT=8080
VERIFY_UI_PORT=3000
VERIFY_DB_PORT=5432
VERIFY_ENDPOINT=http://verify-service:8080/v1/verify
# Public hostname Verify uses when calling back into the suite / wallets.
# For host-only demos leave as localhost; for OpenID4VP handoff use a tunnel host.
VERIFY_PUBLIC_HOST=localhost
