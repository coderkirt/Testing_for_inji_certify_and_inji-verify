# Copy to compose/.env and adjust. All values have compose defaults.

# --- OpenID Foundation conformance suite (prebuilt, no API token) ---
IMAGE_TAG=latest
BASE_URL=https://localhost.emobix.co.uk:8443
MONGODB_IMAGE=mongo:6.0.13
SPRING_PROFILES_ACTIVE=dev

# --- Inji Certify (OpenID4VCI 1.0 issuer) ---
# 1.0.0-alpha.1 is the current 1.0 line for this repository on Docker Hub
# (it shares a digest with :latest). Verified 2026-09.
CERTIFY_IMAGE=injistack/inji-certify-with-plugins:1.0.0-alpha.1
# Fallback: the 0.14.x image the vendored certify_init.sql was taken from.
# Use this if Certify fails to boot against the vendored schema seed.
#CERTIFY_IMAGE=injistack/inji-certify-with-plugins:0.14.0
CERTIFY_HOST_PORT=8090
CERTIFY_NGINX_PORT=8091
CERTIFY_DB_PORT=5433

# The issuer identity Certify advertises, and the URL the harness gives the
# conformance suite as vci.credential_issuer_url. Keep them identical.
CERTIFY_ISSUER_URL=http://certify-nginx
CERTIFY_ISSUER_PUBLIC_URL=http://certify-nginx:80
# Credential configuration id the issuer plan requests (seeded by certify_init.sql).
CERTIFY_CREDENTIAL_CONFIGURATION_ID=FarmerCredential

# --- Inji Verify (OpenID4VP 1.0 verifier) ---
# :latest currently resolves to the 1.0.0-alpha line for this repository.
# Pin the explicit tag here once you have confirmed which one you are testing.
VERIFY_IMAGE=injistack/inji-verify-service:latest
VERIFY_UI_IMAGE=injistack/inji-verify-ui:latest
VERIFY_HOST_PORT=8080
VERIFY_UI_PORT=3000
VERIFY_DB_PORT=5432
VERIFY_ENDPOINT=http://verify-service:8080/v1/verify
# Public hostname Verify uses when calling back into the suite / wallets.
# For host-only demos leave as localhost; for OpenID4VP handoff use a tunnel host.
VERIFY_PUBLIC_HOST=localhost

# --- Report publishing (matches the api-testrig S3Adapter config keys) ---
# See runner/README.md. Leave off for local runs.
PUSH_REPORTS_TO_S3=false
S3_HOST=
S3_REGION=us-east-1
S3_USER_KEY=
S3_USER_SECRET=
# api-testrig pushes to this bucket by default.
S3_ACCOUNT=automationtests
REPORT_EXPIRATION_IN_DAYS=30
S3_PREFIX=conformance
