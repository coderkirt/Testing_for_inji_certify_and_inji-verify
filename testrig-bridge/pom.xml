<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.mosip.testrig.apirig</groupId>
    <artifactId>openid-conformance-testrig-bridge</artifactId>
    <version>1.0.0</version>
    <name>OpenID Conformance api-testrig bridge</name>
    <description>Drop-in TestNG suite that maps OIDF conformance results into api-testrig reports</description>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <testng.version>7.8.0</testng.version>
        <jackson.version>2.17.2</jackson.version>
        <extent.version>5.1.2</extent.version>

        <!-- Empty by default. Without these, an unset -Dconformance.results
             would be injected as the literal string "${conformance.results}"
             and ConformanceRunner would believe it had a configured path. -->
        <conformance.results></conformance.results>
        <conformance.component></conformance.component>
        <conformance.repoRoot></conformance.repoRoot>
        <suiteXmlFile>src/test/resources/testng-certify.xml</suiteXmlFile>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.aventstack</groupId>
            <artifactId>extentreports</artifactId>
            <version>${extent.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <systemPropertyVariables>
                        <conformance.results>${conformance.results}</conformance.results>
                        <conformance.component>${conformance.component}</conformance.component>
                        <conformance.repoRoot>${conformance.repoRoot}</conformance.repoRoot>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
      Two ways to run this module:

        mvn test
            Runs the unit tests only (ResultMapperTest). No stack, no suite.

        mvn -Pconformance-suite test -DsuiteXmlFile=src/test/resources/testng-certify.xml \
            -Dconformance.results=../results/certify/results.json -Dconformance.component=certify
            Runs the TestNG suite. The profile is required: passing
            -DsuiteXmlFile without it is silently ignored by surefire, which
            then runs the unit test instead of the suite.

      Each suite XML in src/test/resources also lists ResultMapperTest first, so
      a suite run proves the mapper before it maps.
    -->
    <profiles>
        <profile>
            <id>conformance-suite</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <suiteXmlFiles>
                                <suiteXmlFile>${suiteXmlFile}</suiteXmlFile>
                            </suiteXmlFiles>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
