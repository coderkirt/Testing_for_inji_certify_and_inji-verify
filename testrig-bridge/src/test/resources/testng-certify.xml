<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Replays results/certify/results.json when reuseResults is set. -->
<suite name="InjiCertify-OpenIDConformance" verbose="1">
    <listeners>
        <listener class-name="io.mosip.testrig.apirig.openid.ExtentReportListener"/>
    </listeners>
    <test name="certify-issuer-plan">
        <classes>
            <class name="io.mosip.testrig.apirig.injicertify.testscripts.OpenIDConformanceTest"/>
        </classes>
    </test>
</suite>
