<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Replays results/verify/results.json when reuseResults is set. -->
<suite name="InjiVerify-OpenIDConformance" verbose="1">
    <listeners>
        <listener class-name="io.mosip.testrig.apirig.openid.ExtentReportListener"/>
    </listeners>
    <test name="verify-verifier-plan">
        <classes>
            <class name="io.mosip.testrig.apirig.injiverify.testscripts.OpenIDConformanceTest"/>
        </classes>
    </test>
</suite>
